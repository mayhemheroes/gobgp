FROM gcr.io/oss-fuzz-base/base-builder-go

# Install jq for validation and grep for compile_native_go_fuzzer (OSS-Fuzz base uses Debian/Ubuntu)
# Note: OSS-Fuzz base may have BusyBox grep, but compile_native_go_fuzzer needs GNU grep
RUN apt-get update && apt-get install -y jq grep findutils && \
    rm -rf /var/lib/apt/lists/* && \
    # Verify GNU grep is available (not BusyBox)
    grep --version 2>&1 | grep -q "GNU grep" || (echo "ERROR: GNU grep not installed" && exit 1)

# Install any additional dependencies
# (base-builder-go already includes Go, libFuzzer, and standard build tools)

# Copy MTV binary for test execution and validation
COPY --from="us-east4-docker.pkg.dev/forallsecure-1/rlenv-staging/rlenv-mtv-static:latest" /rlenv/bin/mtv /rlenv/bin/mtv

# Set up environment variables for fuzzing
ENV FUZZING_LANGUAGE=go
ENV SANITIZER=address
ENV FUZZING_ENGINE=libfuzzer
ENV ARCHITECTURE=x86_64
ENV PROJECT_NAME=gobgp

# Make Go toolchain accessible to all users (not just root)
# The base image installs Go under /root/.go/bin and /root/go/bin
# We need to make these accessible for non-root users during validation
ENV PATH="/root/.go/bin:/root/go/bin:${PATH}"
# Set Go cache locations to use the build cache created during Docker build
ENV GOCACHE="/root/.cache/go-build"
ENV GOMODCACHE="/root/go/pkg/mod"

# Copy source code to standardized location
COPY . /rlenv/source/gobgp

# Make /rlenv/source world-writable for unprivileged users
RUN chmod -R 777 /rlenv/source

# Set working directory
WORKDIR /rlenv/source/gobgp

# Install Go dependencies
RUN go get github.com/AdamKorcz/go-118-fuzz-build/testing

# Compile libfuzzer support
RUN compile_libfuzzer

# Apply sed fix to remove benchmark function
RUN sed -i '/func BenchmarkNormalizeFlowSpecOpValues(/,/^}/ s/^/\/\//' pkg/packet/bgp/bgp_test.go

# Set compiler flags
ENV CXXFLAGS="-fsanitize=address -lpthread"

# Build the fuzz target
RUN compile_native_go_fuzzer $PWD/pkg/packet/bgp FuzzParseBGPMessage fuzz_parse_bgp_message || true

# Fix the "reflect imported and not used" issue if it occurs
RUN if [ -f pkg/packet/bgp/bgp_test.go_fuzz.go ]; then \
      sed -i '/^[[:space:]]*"reflect"$/d' pkg/packet/bgp/bgp_test.go_fuzz.go; \
    fi

# Rebuild after fixing the reflect import issue
RUN compile_native_go_fuzzer $PWD/pkg/packet/bgp FuzzParseBGPMessage fuzz_parse_bgp_message

# Make /out directory world-writable for unprivileged users
RUN chmod -R 777 /out

# Make Go cache directories accessible to all users (for rebuilds without network)
RUN chmod -R 777 /root/.cache 2>/dev/null || true

# Make /root directory and Go installation accessible to all users
RUN chmod 777 /root && \
    chmod -R 777 /root/.go /root/go 2>/dev/null || true

# Copy rlenv directory (contains test data and scripts) - this should be last
COPY rlenv /rlenv

# Default command
CMD ["/out/fuzz_parse_bgp_message"]
